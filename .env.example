# SkillSphere Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual values

# PostgreSQL / Neon Database URL
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
